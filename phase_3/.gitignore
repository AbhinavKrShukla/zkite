# Rust build output (renderer/spike1/pybridge/gpu_harness/conformance).
target/

# gpu_harness build outputs — regenerated by scripts/build.sh + build_apk.sh.
gpu_harness/build/
gpu_harness/artifacts/

# Python caches.
__pycache__/
*.pyc
.pytest_cache/

# conformance's own tooling + generated artifacts (§9 — regenerated by run.sh):
# manifest.json comes straight from fixtures.py, out/ is every rendered/diffed PNG
# plus report.json, node_modules is a symlink to phase_1/webruntime/test's own
# (which already vendors the pinned Playwright install).
conformance/manifest.json
conformance/out/
# One directory per non-default device pixel ratio (PLAN.md §13.1.2) — same content as
# out/, rendered at that dpr.
conformance/out-dpr*/
conformance/node_modules
