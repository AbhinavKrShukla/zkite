# Downloaded, not authored — release-pipeline-only tools (§1.5), regenerable.
/vendor/protoc/
# Downloaded, not authored — used only to *verify* zkite build's AAB output
# (bundletool validate / build-apks), never invoked by zkite itself.
/vendor/bundletool/

# vendor/pip/pip.pyz *is* committed on purpose, same rationale as
# phase_1/webruntime/vendor/*.js: small (~1.7MB), pinned, and what actually ships
# in the zkite wheel (see PLAN.md §1.3) — not a build artifact to regenerate.

# Rust build output.
/*/target/

# appshell build outputs — regenerated by scripts/build.sh + build_dex.sh, same
# convention as phase_1/devshell's build/ and artifacts/ (also gitignored there).
# `zkite build` reads these from a local build, not from git.
/appshell/build/
/appshell/artifacts/

# A disposable `zkite new` app used to exercise `zkite build` — regenerate with
# `zkite new testapp`, not meant to be tracked (includes generated keystores/dist/).
/fixtures/*/

# Python caches.
__pycache__/
*.pyc
