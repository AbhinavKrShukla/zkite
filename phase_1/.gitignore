# Rust build output.
target/

# devshell build outputs — regenerated by scripts/build.sh + build_apk.sh from
# phase_0/vendor's Python prefixes, which are themselves gitignored there.
devshell/build/
devshell/artifacts/

# Python caches.
__pycache__/
*.pyc
.pytest_cache/

# Test tooling — webruntime/test/package.json declares the pin, npm install recreates this.
node_modules/

# webruntime/vendor/*.js *is* committed on purpose: it's small (< 300KB total), pinned
# by the adjacent *.VERSION files, and is what ships in the wheel — not a build
# artifact to regenerate on every clone.
